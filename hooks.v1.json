{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/pre-exec-guard.py",
          "timeout": 190
        }
      ]
    },
    {
      "matcher": "^(write|edit|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/pre-write-guard.py",
          "timeout": 90
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(exec|mcp_call_tool)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/post-exec.py",
          "timeout": 30
        }
      ]
    },
    {
      "matcher": "^(write|edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/memory-post-edit.py",
          "timeout": 10
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/constraint-pinning.py",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/user-prompt.py",
          "timeout": 20
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/session-start.py",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/stop-guard.py",
          "timeout": 25
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/memory-stop.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "",
      "hooks": []
    }
  ]
}
