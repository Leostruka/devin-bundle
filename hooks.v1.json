{
  "PreToolUse": [
    {
      "matcher": "^(exec|write_to_process)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/pre-exec-guard.py",
          "timeout": 300,
          "fail_closed": true
        }
      ]
    },
    {
      "matcher": "^(write|edit|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/pre-write-guard.py",
          "timeout": 90,
          "fail_closed": true
        }
      ]
    },
    {
      "matcher": "^(run_subagent|mcp_call_tool|mcp_read_resource|webfetch|web_search|skill|request_scope|ask_user_question|todo_write|browser_preview)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/validate-tool-args.py",
          "timeout": 30,
          "fail_closed": true
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(exec|write_to_process|mcp_call_tool)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/post-exec-guard.py",
          "timeout": 40
        }
      ]
    },
    {
      "matcher": "^(write|edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/post-write-guard.py",
          "timeout": 30
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/constraint-pinning.py",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "python scripts/context-pressure.py",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "python scripts/compact-gate.py",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/user-prompt.py",
          "timeout": 20
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/session-start.py",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/stop-guard.py",
          "timeout": 25
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/memory-stop.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/permission-gate.py",
          "timeout": 15,
          "fail_closed": false
        }
      ]
    }
  ]
}
