{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/destructive-gate.py\"",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python \"scripts/check-ai-signature.py\"",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python \"scripts/check-push-green.py\"",
          "timeout": 150
        }
      ]
    },
    {
      "matcher": "^(write|edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/check-ai-signature.py\"",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python \"scripts/validate-mermaid.py\"",
          "timeout": 60
        }
      ]
    },
    {
      "matcher": "^(exec|read|write|edit|grep|glob|notebook_read|notebook_edit|webfetch|web_search|find_file_by_name|run_subagent|read_subagent|mcp_call_tool|mcp_read_resource|get_output|write_to_process|kill_shell|skill|request_scope|mcp_list_tools|mcp_list_servers)$",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/validate-tool-args.py\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/silent-error-review.py\"",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python \"scripts/context-pressure.py\"",
          "timeout": 5
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/constraint-pinning.py\"",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/constraint-pinning.py\"",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/constraint-pinning.py\"",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "python \"scripts/context-budget.py\"",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python \"scripts/check-ai-signature.py\"",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "python \"scripts/refine-review-prompt.py\"",
          "timeout": 5
        }
      ]
    }
  ]
}
