{
  "comment": "Task-adaptive harness recipes. SWE-2 routes by effort level (medium/high/max), resolved to model ids via bundle-models.json. preferred_model can be a role (parent, max, medium, subagent) or an explicit model id. Override per-recipe via env vars BUNDLE_RECIPE_<NAME>_MODEL.",
  "effort_routing": {
    "medium": "Simple tasks, spot fixes, isolated scripts.",
    "high": "Tasks spanning multiple files; default for general work.",
    "max": "Open-ended tasks, global refactors, long-horizon coding."
  },
  "recipes": {
    "audit": {
      "name": "audit",
      "instruction_signals": ["audit", "lint", "validate", "check"],
      "preferred_model_role": "parent",
      "preferred_model": null,
      "tools": ["read", "grep", "exec", "find_file_by_name"],
      "sidekick_profile": "qa-ci",
      "main_responsible_for": ["plan", "final_review"]
    },
    "refine": {
      "name": "refine",
      "instruction_signals": ["refine", "improve", "rewrite", "polish"],
      "preferred_model_role": "max",
      "preferred_model": null,
      "tools": ["read", "edit", "write"],
      "sidekick_profile": "reviewer",
      "main_responsible_for": ["ambiguity_resolution", "final_review"]
    },
    "implement": {
      "name": "implement",
      "instruction_signals": ["implement", "add", "feature", "fix"],
      "preferred_model_role": "medium",
      "preferred_model": null,
      "tools": ["read", "edit", "write", "exec"],
      "sidekick_profile": "implementer",
      "main_responsible_for": ["plan", "ambiguity_resolution", "final_review"]
    },
    "research": {
      "name": "research",
