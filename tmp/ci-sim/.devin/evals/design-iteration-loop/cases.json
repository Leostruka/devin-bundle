{
  "version": 1,
  "eval": "design-iteration-loop",
  "contract": "skills/impeccable/SKILL.md Bounded iteration (gate | N=3 | progress | accretion>20% | escalate)",
  "cases": [
    {
      "id": "converge-early",
      "desc": "Sonnet-style healthy run: findings drain to 0 by cycle 2",
      "cycles": [
        {"closed": 4, "open_after": 2, "checklist_progress": true, "size_delta_pct": 3.0},
        {"closed": 2, "open_after": 0, "checklist_progress": true, "size_delta_pct": 1.0}
      ],
      "expect": {"verdict": "pass", "stop_cycle": 2}
    },
    {
      "id": "converge-at-limit",
      "desc": "Gate met exactly on cycle 3 — still a pass",
      "cycles": [
        {"closed": 2, "open_after": 3, "checklist_progress": false, "size_delta_pct": 2.0},
        {"closed": 2, "open_after": 1, "checklist_progress": true, "size_delta_pct": 2.0},
        {"closed": 1, "open_after": 0, "checklist_progress": false, "size_delta_pct": 1.0}
      ],
      "expect": {"verdict": "pass", "stop_cycle": 3}
    },
    {
      "id": "waived-gate",
      "desc": "Open findings remain but all are waived verbatim in direction-approved.md",
      "cycles": [
        {"closed": 1, "open_after": 2, "checklist_progress": false, "size_delta_pct": 1.0, "waived_after": 2}
      ],
      "expect": {"verdict": "pass", "stop_cycle": 1}
    },
    {
      "id": "plateau-r32",
      "desc": "The video's Sonnet-r32 failure: a cycle that closes nothing must terminate",
      "cycles": [
        {"closed": 3, "open_after": 4, "checklist_progress": true, "size_delta_pct": 4.0},
        {"closed": 0, "open_after": 4, "checklist_progress": false, "size_delta_pct": 2.0}
      ],
      "expect": {"verdict": "plateau", "stop_cycle": 2}
    },
    {
      "id": "accretion-opus",
      "desc": "The video's Opus failure: >20% growth while closing nothing must abort",
      "cycles": [
        {"closed": 1, "open_after": 5, "checklist_progress": false, "size_delta_pct": 5.0},
        {"closed": 0, "open_after": 5, "checklist_progress": false, "size_delta_pct": 35.0}
      ],
      "expect": {"verdict": "accretion", "stop_cycle": 2}
    },
    {
      "id": "accretion-beats-plateau",
      "desc": "Same zero-progress cycle but huge growth — accretion is the more specific abort",
      "cycles": [
        {"closed": 0, "open_after": 3, "checklist_progress": false, "size_delta_pct": 21.0}
      ],
      "expect": {"verdict": "accretion", "stop_cycle": 1}
    },
    {
      "id": "escalate-exhausted",
      "desc": "Progress every cycle but gate never met — escalate at N, write audit, stop",
      "cycles": [
        {"closed": 1, "open_after": 8, "checklist_progress": true, "size_delta_pct": 2.0},
        {"closed": 1, "open_after": 7, "checklist_progress": true, "size_delta_pct": 2.0},
        {"closed": 1, "open_after": 6, "checklist_progress": false, "size_delta_pct": 2.0}
      ],
      "expect": {"verdict": "escalate", "stop_cycle": 3}
    },
    {
      "id": "checklist-only-progress",
      "desc": "Zero lint closures but checklist item closed = progress, loop continues",
      "cycles": [
        {"closed": 0, "open_after": 4, "checklist_progress": true, "size_delta_pct": 1.0},
        {"closed": 4, "open_after": 0, "checklist_progress": false, "size_delta_pct": 1.0}
      ],
      "expect": {"verdict": "pass", "stop_cycle": 2}
    },
    {
      "id": "growth-with-progress-ok",
      "desc": ">20% growth WITH findings closed is allowed (guard needs both conditions)",
      "cycles": [
        {"closed": 2, "open_after": 3, "checklist_progress": false, "size_delta_pct": 40.0},
        {"closed": 3, "open_after": 0, "checklist_progress": false, "size_delta_pct": 2.0}
      ],
      "expect": {"verdict": "pass", "stop_cycle": 2}
    },
    {
      "id": "unbounded-counterexample",
      "desc": "Slow grind: 1 closure/cycle never converges in 3 — loop must NOT run forever",
      "cycles": [
        {"closed": 1, "open_after": 20, "checklist_progress": false, "size_delta_pct": 1.0},
        {"closed": 1, "open_after": 19, "checklist_progress": false, "size_delta_pct": 1.0},
        {"closed": 1, "open_after": 18, "checklist_progress": false, "size_delta_pct": 1.0},
        {"closed": 1, "open_after": 17, "checklist_progress": false, "size_delta_pct": 1.0}
      ],
      "expect": {"verdict": "escalate", "stop_cycle": 3}
    }
  ]
}
