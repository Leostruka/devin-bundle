{
  "version": 1,
  "tools": {
    "devin": {
      "label": "Devin CLI",
      "format": "devin-hooks+skills",
      "installKind": "roster",
      "dest": "%APPDATA%/devin",
      "renderer": "scripts/render-user-hooks.py",
      "enabled": true,
      "detect": ["%APPDATA%/devin/config.json", "devin --version"]
    },
    "gemini": {
      "label": "Gemini CLI",
      "format": "gemini-md+settings",
      "installKind": "roster",
      "dest": null,
      "renderer": null,
      "enabled": false,
      "detect": []
    },
    "claude": {
      "label": "Claude Code",
      "format": "claude-md+settings",
      "installKind": "roster",
      "dest": null,
      "renderer": null,
      "enabled": false,
      "detect": []
    },
    "codex": {
      "label": "Codex CLI",
      "format": "codex-md+toml",
      "installKind": "roster",
      "dest": null,
      "renderer": null,
      "enabled": false,
      "detect": []
    }
  }
}
